{
  "name": "lift-workout-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal hypertrophy workout tracker (PWA)",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-routine.mjs",
    "build": "node scripts/validate-routine.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
  }
}
